  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  firstButton: {fileID: 591555714}
  dialogueText: {fileID: 813293337}
  continueButton: {fileID: 26447934}
  dialogues:
  - You are a hungry elephant who has lost your herd and has been wandering through
    the forest.
  - Following the smell of food, you arrive at a nearby village.
  - Enter the village and find crops to fill your tummy.
  - But be careful ! a Kumki(trained fighter) elephant is already there, waiting
    to catch you.
  typingSpeed: 0.04
  audioSource: {fileID: 1510942765}
  typingSound: {fileID: 8300000, guid: 4e15482e0db48184aa3efd0888f1eecf, type: 3}
